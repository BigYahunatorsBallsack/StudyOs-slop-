{
  "name": "studyos",
  "version": "2.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "python3 -m http.server 8080 --directory dist",
    "lint": "eslint --max-warnings 0 src tests build.mjs",
    "test": "TZ=Europe/Berlin vitest run",
    "test:e2e": "node build.mjs && TZ=Europe/Berlin playwright test --project=mobil",
    "test:function": "node build.mjs && node tests/deno/run-function.mjs node_modules/.bin/deno",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:function && npm run test:e2e",
    "test:visual": "node build.mjs && TZ=Europe/Berlin playwright test --project=bilder"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@supabase/auth-js": "^2.118.0",
    "@supabase/postgrest-js": "^2.118.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
