{
  // Nur Typprüfung (kein Build): reine Logik in lib/ und die Edge Function in server/, über JSDoc-Kommentare
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/lib/**/*.js", "src/server/**/*.js", "src/types.d.ts"]
}
